<html lang="es"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Testotron - Iniciar sesión</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/main.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="icon" type="image/x-icon" href="/assets/img/logo.png">
    <style>
        body { background-color: var(--bg-main); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .auth-container { max-width: 550px; width: 100%; padding: 2rem; }
        .text-sentence { text-transform: lowercase; }
        .text-sentence::first-letter { text-transform: uppercase; }
        .btn-primary { background-color: var(--color-primary); border-color: var(--color-primary); }
        .btn-success { background-color: var(--color-success); border-color: var(--color-success); }
    </style>
</head>

<body>

    <a href="#main-content" class="visually-hidden-focusable position-absolute top-0 start-0 p-2 bg-white border">Saltar al contenido principal</a>

    <main class="auth-container" id="main-content">
        <header class="text-center mb-3">
    <img src="/assets/img/logo.png" alt="Logotipo de Testotron" width="64" class="mb-3">
    <h1 class="h3 fw-bold">Testotron</h1>
    <p class="text-muted text-sentence">Gestiona cuestionarios de forma rápida, clara y organizada</p>
</header>
<section class="card shadow-sm border-0 p-4 mb-2" aria-labelledby="login-title">
    <!--<h2 id="login-title" class="h4 mb-4 fw-semibold text-sentence">Iniciar sesión</h2>-->

    <form id="loginForm" action="/auth/login" method="POST">
        <div class="mb-3">
            <label for="email" class="form-label text-sentence">Correo electrónico</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-envelope text-muted" aria-hidden="true"></i>
                </span>
                <input type="email" id="email" name="email" class="form-control border-start-0" placeholder="" required="" autocomplete="email">
            </div>
        </div>

        <div class="mb-4">
            <label for="password" class="form-label text-sentence">Contraseña</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-lock text-muted" aria-hidden="true"></i>
                </span>
                <input type="password" id="password" name="password" class="form-control border-start-0" placeholder="" required="" autocomplete="current-password">
            </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 mb-3 text-sentence" aria-label="Enviar credenciales para iniciar sesión">
            Iniciar sesión
        </button>

        <div class="text-center">
            <a href="/auth/register" class="text-decoration-none" style="color: var(--color-primary);">
                ¿No tienes cuenta? Regístrate
            </a>
        </div>
    </form>
</section>
        <section class="card shadow-sm border-0 p-3" aria-labelledby="quick-access-title">
            <p id="quick-access-title" class="small mb-2 text-sentence fw-medium">Acceso rápido con código:</p>
            <form id="quickAccessForm" action="/quizzes/join" method="GET" class="d-flex gap-2">
                <label for="quiz-code" class="visually-hidden text-sentence">Ingresa el código del cuestionario</label>
                <input type="text" id="quiz-code" name="code" class="form-control form-control-sm" placeholder="" required="">
                <button type="submit" class="btn btn-success btn-sm px-4 text-sentence" aria-label="Acceder al cuestionario con código">
                    Acceder
                </button>
            </form>
        </section>    </main>

    <!-- API Config -->
    <script>
        window.__API_BASE__ =
            window.__API_BASE__ ||
            (window.__env && window.__env.API_BASE) ||
            'http://localhost:8080';
    </script>

    <!-- Scripts -->
    <script src="/assets/js/env.js"></script>
    <script src="/assets/js/api-client.js"></script>
    <script src="/assets/js/auth.js"></script>


</body></html>