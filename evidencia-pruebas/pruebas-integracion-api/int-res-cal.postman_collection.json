    {
      "name": "02 - Creacion de Intento",
      "item": [
        {
          "name": "Crear Intento en Examen Publicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Validación del Status Code",
                  "pm.test(\"Status 201 o 200 (nuevo o reanudado)\", () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "// Parseamos el JSON una sola vez para mejorar el rendimiento",
                  "const responseData = pm.response.json();",
                  "",
                  "// 2. Validación de la estructura y asignación de la variable de Ambiente",
                  "pm.test(\"Respuesta contiene attempt con id\", () => {",
                  "    pm.expect(responseData.attempt).to.be.an('object');",
                  "    pm.expect(responseData.attempt.id).to.be.a('number');",
                  "    ",
                  "    // GUARDA EN EL AMBIENTE (Environment) con la mayúscula exacta",
                  "    pm.environment.set('attemptId', responseData.attempt.id);",
                  "});",
                  "",
                  "// 3. Validación del test_code asociado",
                  "pm.test(\"Intento asociado al test correcto\", () => {",
                  "    pm.expect(responseData.attempt.test_code).to.equal(pm.collectionVariables.get('testCode'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tests/{{testCode}}/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tests", "{{testCode}}", "start"]
            }
          },
          "response": []
        },
        {
          "name": "Reanudar Intento Existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
