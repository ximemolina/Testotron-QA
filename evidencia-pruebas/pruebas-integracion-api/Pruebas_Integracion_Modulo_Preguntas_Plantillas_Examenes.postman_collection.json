          "name": "10. El docente actualiza el tipo de pregunta sin ajustar metadata (DEF-QUES-006)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Defecto DEF-QUES-006: actualización aceptada sin validar consistencia\", function() {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(pm.response.json().success).to.equal(true);",
                  "    var question = pm.response.json().question;",
                  "    pm.expect(question.type).to.equal(\"true_false\");",
                  "    // metadata.options sigue presente y es incompatible con el tipo true_false,",
                  "    // pero el sistema acepta la actualización sin advertencia",
                  "    pm.expect(question.metadata.options).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
