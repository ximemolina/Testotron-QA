    {
      "name": "Configuración de autenticación",
      "item": [
        {
          "name": "1. Iniciar sesión como docente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Inicio de sesión del docente exitoso\", function() {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(pm.response.json().token).to.exist;",
                  "});",
                  "",
                  "var loginData = pm.response.json();",
                  "pm.collectionVariables.set(\"teacher_token\", loginData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
