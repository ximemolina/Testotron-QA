        {
          "name": "5. El docente genera un examen desde la plantilla (DEF-QUES-005)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"El uso de la plantilla redirige a la vista de edición del examen\", function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 301, 302]);",
                  "});",
                  "",
                  "// El endpoint responde con un redirect a /teacher/quizzes/edit/:code",
                  "var location = pm.response.headers.get(\"Location\");",
                  "if (location) {",
                  "    var match = location.match(/quizzes\\/edit\\/([A-Za-z0-9]+)/);",
                  "    if (match) {",
                  "        pm.collectionVariables.set(\"generated_test_code\", match[1]);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacher_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/templates/{{template_id}}/use",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "templates",
                "{{template_id}}",
                "use"
              ]
            }
          },
          "response": [],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "5.2. Verificar que el examen generado contiene todas las preguntas de la plantilla (DEF-QUES-005)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Defecto DEF-QUES-005: no se aplican reglas de selección\", function() {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    var test = pm.response.json().test;",
                  "    // RF-TPL-02 esperaría aplicar selección/cantidad/etiquetas,",
                  "    // pero el examen generado contiene exactamente las mismas preguntas de la plantilla",
                  "    pm.expect(test.questions.length).to.equal(1);",
                  "    pm.expect(test.questions[0].question).to.include(\"capital de Costa Rica\");",
                  "    pm.expect(test.status).to.equal(\"draft\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
