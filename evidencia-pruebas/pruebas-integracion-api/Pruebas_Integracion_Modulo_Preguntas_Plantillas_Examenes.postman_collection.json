        {
          "name": "11.2. El docente vuelve a cerrar un examen ya cerrado (DEF-QUES-003)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Defecto DEF-QUES-003: cerrar un examen ya cerrado responde 200\", function() {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(pm.response.json().closed).to.equal(true);",
                  "    // No hay validación de estado previo: el endpoint responde igual",
                  "    // sin importar si el examen ya estaba cerrado o ni siquiera existe",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
