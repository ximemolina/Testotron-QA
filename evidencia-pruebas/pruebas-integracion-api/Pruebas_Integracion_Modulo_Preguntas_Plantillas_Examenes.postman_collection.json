              "raw": "{\n    \"title\": \"Plantilla de Geografía\",\n    \"description\": \"Plantilla reutilizable para exámenes cortos de geografía\",\n    \"instructions\": \"Responda todas las preguntas\",\n    \"time_limit_minutes\": 30,\n    \"questions\": [\n        { \"question_id\": {{question_id}}, \"pts\": 2 }\n    ]\n}"
