        {
          "name": "4.2. Verificar que descripción y tiempo límite se perdieron (DEF-QUES-002)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Defecto DEF-QUES-002: campos no enviados quedan en NULL\", function() {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    var template = pm.response.json().template;",
                  "    pm.expect(template.title).to.equal(\"Plantilla de Geografía (actualizada)\");",
                  "    // Se esperaría que description y time_limit_minutes conserven su valor original,",
                  "    // pero updateTemplate() sin COALESCE los sobrescribe con NULL",
                  "    pm.expect(template.description).to.be.null;",
                  "    pm.expect(template.time_limit_minutes).to.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
