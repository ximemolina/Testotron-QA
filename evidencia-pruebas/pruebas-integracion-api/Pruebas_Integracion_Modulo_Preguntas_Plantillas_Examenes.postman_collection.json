              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pruebas del ciclo de vida de preguntas, plantillas y exámenes",
      "item": [
        {
          "name": "1. El docente crea una pregunta en el banco",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Pregunta creada exitosamente\", function() {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(pm.response.json().success).to.equal(true);",
                  "    pm.expect(pm.response.json().question.id).to.exist;",
                  "});",
                  "",
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set(\"question_id\", data.question.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{teacher_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"question\": \"¿Cuál es la capital de Costa Rica?\",\n    \"type\": \"multiple_choice\",\n    \"metadata\": { \"options\": [\"San José\", \"Heredia\", \"Alajuela\", \"Cartago\"] },\n    \"correct_answer\": \"San José\",\n    \"difficulty\": \"easy\",\n    \"category\": \"geografia\",\n    \"is_public\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/questions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "questions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. El docente crea una plantilla con la pregunta",
