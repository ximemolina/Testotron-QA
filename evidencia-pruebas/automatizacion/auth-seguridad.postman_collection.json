      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('defecto reproducido: permite actualizar el rol propio', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const raw = pm.response.text();",
