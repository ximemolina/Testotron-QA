{
  "info": {
    "_postman_id": "4f919ee7-cf37-4f46-9861-fd32197ad3b7",
    "name": "Testotron - Auth y Seguridad",
    "description": "Coleccion Postman v2.1 para ejecutar evidencias API del modulo Autenticacion, usuarios, perfil y seguridad.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "    const runId = Date.now().toString();",
          "    pm.collectionVariables.set('runId', runId);",
          "    pm.collectionVariables.set('studentEmail', `estudiante.qa.${runId}@testotron.local`);",
          "    pm.collectionVariables.set('otherEmail', `otro.usuario.qa.${runId}@testotron.local`);",
          "    pm.collectionVariables.set('adminEmail', `admin.noautorizado.qa.${runId}@testotron.local`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "studentEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "otherEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentPassword",
      "value": "Test1234",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "otherUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "PREP - Registrar estudiante",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('registro de estudiante devuelve 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const body = pm.response.json();",
              "if (body.user && body.user.id) {",
              "    pm.collectionVariables.set('studentId', String(body.user.id));",
              "}",
              "",
              "pm.test('usuario registrado como student', function () {",
              "    pm.expect(body.user).to.have.property('role', 'student');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Estudiante QA Postman\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"role\": \"student\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "PREP - Registrar otro usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('registro de segundo usuario devuelve 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const body = pm.response.json();",
              "if (body.user && body.user.id) {",
              "    pm.collectionVariables.set('otherUserId', String(body.user.id));",
              "}",
              "",
              "pm.test('segundo usuario tiene id para prueba de acceso ajeno', function () {",
              "    pm.expect(pm.collectionVariables.get('otherUserId')).to.not.equal('');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Otro Usuario QA Postman\",\n  \"email\": \"{{otherEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"role\": \"student\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-AUTH-002 - Login estudiante",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login exitoso', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "if (body.token) {",
              "    pm.collectionVariables.set('token', body.token);",
              "}",
              "if (body.user && body.user.id) {",
              "    pm.collectionVariables.set('studentId', String(body.user.id));",
              "}",
              "",
              "pm.test('respuesta contiene usuario y token', function () {",
              "    pm.expect(body).to.have.property('user');",
              "    pm.expect(body).to.have.property('token');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-AUTH-004 - Consultar usuario autenticado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const raw = pm.response.text();",
              "pm.test('no expone password', function () {",
              "    pm.expect(raw).to.not.include('password');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
