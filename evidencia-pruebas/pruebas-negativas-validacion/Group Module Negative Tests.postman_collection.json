        {
          "name": "1.2. Teacher Creates a Group with No Name",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Página de grupos cargada correctamente\", function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(pm.response.text()).to.include(\"Mis grupos\");",
                  "});",
                  "",
                  "// Buscar el código dentro del href",
                  "var html = pm.response.text();",
                  "var match = html.match(/href=\"\\/groups\\/([^\"]+)\"/);",
                  "",
                  "if (match) {",
                  "    // Guardar en variables de colección",
                  "    pm.collectionVariables.set(\"group_code\", match[1]);",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{teacher_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"\",\n    \"description\": \"Grupo de estudiantes para el curso de matemáticas básicas del semestre 2026-I\"\n}"
