        {
          "name": "3.2. Teacher Consults Nonexistent Group Information (Basic)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Group information retrieved successfully\", function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "",
                  "    var groupData = pm.response.json();",
                  "",
                  "    // Validar que existe la propiedad group",
                  "    pm.expect(groupData).to.have.property(\"group\");",
                  "",
                  "    // Validar que el objeto group tiene las propiedades esperadas",
                  "    pm.expect(groupData.group).to.have.property(\"code\");",
                  "    pm.expect(groupData.group).to.have.property(\"name\");",
                  "    pm.expect(groupData.group).to.have.property(\"owner_id\");",
                  "    pm.expect(groupData.group).to.have.property(\"created_at\");",
                  "    pm.expect(groupData.group).to.have.property(\"updated_at\");",
                  "",
                  "});",
                  "",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
