                  "// Guardar el id del usuario en variables de colección",
                  "try {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.user && jsonData.user.id) {",
                  "        pm.collectionVariables.set(\"student_id\", jsonData.user.id);",
                  "        console.log(\"student_id guardado en colección:\", jsonData.user.id);",
                  "    }",
                  "} catch (e) {",
