          "name": "1. Register Teacher",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Teacher registration successful\", function() {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    pm.expect(pm.response.json().success).to.equal(true);",
                  "});",
                  "",
                  "var teacherData = pm.response.json();",
                  "pm.environment.set(\"teacher_id\", teacherData.user.id);",
                  "pm.environment.set(\"teacher_email\", teacherData.user.email);",
                  "pm.environment.set(\"teacher_password\", pm.request.body.params[2].value);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
