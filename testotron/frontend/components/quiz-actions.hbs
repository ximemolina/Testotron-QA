<div
  class="d-flex flex-wrap justify-content-end gap-1"
  role="group"
  aria-label="Acciones para: {{this.title}}"
>

  <a
    href="/teacher/quizzes/edit/{{this.code}}"
    class="btn btn-sm btn-outline-primary"
    aria-label="Editar cuestionario: {{this.title}}"
  >
    <i class="bi bi-pencil" aria-hidden="true"></i>
    <span class="visually-hidden">Editar</span>
  </a>

  <a
    href="/teacher/quizzes/view/{{this.code}}"
    class="btn btn-sm btn-outline-secondary"
    aria-label="Ver cuestionario: {{this.title}}"
  >
    <i class="bi bi-eye" aria-hidden="true"></i>
    <span class="visually-hidden">Ver</span>
  </a>

  <button
    type="button"
    class="btn btn-sm btn-outline-secondary duplicate-quiz-btn"
    data-code="{{this.code}}"
    aria-label="Duplicar cuestionario: {{this.title}}"
  >
    <i class="bi bi-files" aria-hidden="true"></i>
    <span class="visually-hidden">Duplicar</span>
  </button>

  <button
    type="button"
    class="btn btn-sm btn-outline-secondary share-quiz-btn"
    data-code="{{this.code}}"
    aria-label="Compartir código del cuestionario: {{this.title}}"
  >
    <i class="bi bi-share" aria-hidden="true"></i>
    <span class="visually-hidden">Compartir</span>
  </button>

  <button
    type="button"
    class="btn btn-sm btn-outline-danger delete-quiz-btn"
    data-code="{{this.code}}"
    aria-label="Eliminar cuestionario: {{this.title}}"
  >
    <i class="bi bi-trash" aria-hidden="true"></i>
    <span class="visually-hidden">Eliminar</span>
  </button>

</div>
