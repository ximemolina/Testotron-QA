<div
  class="modal fade"
  id="joinGroupModal"
  tabindex="-1"
  aria-labelledby="joinGroupModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="joinGroupModalLabel">
          Ingresar a grupo
        </h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Cerrar"
        ></button>
      </div>
      <div class="modal-body">
        <form id="joinGroupForm" action="api/groups/join" method="POST">
          <div class="mb-3">
            <label class="form-label" for="groupCode">
              Código del grupo
            </label>
            <input
              type="text"
              id="groupCode"
              name="code"
              class="form-control"
              required
            >
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button
          type="button"
          class="btn btn-secondary"
          data-bs-dismiss="modal"
        >
          Cancelar
        </button>
        <button type="submit" form="joinGroupForm" class="btn btn-success">
          Ingresar
        </button>
      </div>
    </div>
  </div>
</div>
