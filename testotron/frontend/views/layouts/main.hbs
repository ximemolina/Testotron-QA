<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{appName}} - {{pageTitle}}</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="icon" type="image/x-icon" href="/assets/img/logo.png">
    
    <!-- CSS Core con Paleta de Colores -->
    <link rel="stylesheet" href="/assets/css/main.css">

    <!-- Secciones opcionales para CSS específico -->
    {{{_sections.head}}}
</head>
<body class="bg-light">

    <!-- Enlace de salto para accesibilidad (Skip to content) -->
    <a href="#main-content" 
        class="visually-hidden-focusable position-absolute top-0 start-0 m-3 btn btn-light shadow-lg" 
        style="z-index: 2000;">
        Saltar al contenido principal
    </a>

    <div class="d-flex flex-column min-vh-100">
        
        <!-- Navbar Superior (Accesibilidad: role="banner") -->
        <header role="banner">
            <!-- Mobile hamburger -->
            <div class="d-flex align-items-center d-lg-none px-3 py-2 border-bottom bg-white">
                <button id="sidebarToggle" type="button" class="btn btn-light me-2"
                    aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="sidebar-nav">
                    <i class="bi bi-list fs-5" aria-hidden="true"></i>
                </button>
            </div>
            {{> navbar}}
        </header>

        <!-- Backdrop for mobile sidebar -->
        <div id="sidebarBackdrop" class="sidebar-backdrop" aria-hidden="true"></div>

        <div class="d-flex flex-grow-1" style="height: calc(100vh - 70px); overflow: hidden;">
            <!-- Sidebar -->
            <aside id="sidebar-nav" class="sidebar-wrapper bg-white border-end" role="navigation" aria-label="Menú principal">
                {{> sidebar}}
            </aside>

            <!-- Right Column: Main + Footer -->
            <div class="d-flex flex-column flex-grow-1 main-content-area">
                <!-- Main content scrolls independently -->
                <main id="main-content" class="container-fluid p-4 flex-grow-1 overflow-auto" role="main">
                    {{{body}}}
                </main>

                <!-- Footer stays at the bottom of this flex column -->
                <footer class="py-2 border-top bg-white" role="contentinfo">
                    <div class="text-center text-muted small px-4">
                        {{> footer}}
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>window.__API_BASE__ = window.__API_BASE__ || (window.__env && window.__env.API_BASE) || 'http://localhost:8080';</script>
    <script src="/assets/js/env.js"></script>
    <script src="/assets/js/api-client.js"></script>
    <script src="/assets/js/auth.js"></script>
    <script src="/assets/js/hydrate-user.js"></script>
    <script src="/assets/js/logout.js"></script>
    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/quick-access.js"></script>
    <script src="/assets/js/teacher-quizzes.js" defer></script>
    {{{_sections.scripts}}}
    <script>
    (function() {
      var toggle = document.getElementById('sidebarToggle');
      var sidebar = document.getElementById('sidebar-nav');
      var backdrop = document.getElementById('sidebarBackdrop');
      if (!toggle || !sidebar || !backdrop) return;

      function openSidebar() {
        sidebar.classList.add('sidebar-open');
        backdrop.classList.add('show');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Cerrar menú de navegación');
        document.body.style.overflow = 'hidden';
      }

      function closeSidebar() {
        sidebar.classList.remove('sidebar-open');
        backdrop.classList.remove('show');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menú de navegación');
        document.body.style.overflow = '';
      }

      toggle.addEventListener('click', function() {
        if (sidebar.classList.contains('sidebar-open')) {
          closeSidebar();
        } else {
          openSidebar();
        }
      });

      backdrop.addEventListener('click', closeSidebar);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && sidebar.classList.contains('sidebar-open')) {
          closeSidebar();
          toggle.focus();
        }
      });
    })();
    </script>
</body>
</html>