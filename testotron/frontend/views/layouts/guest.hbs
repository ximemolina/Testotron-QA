<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{appName}} - {{pageTitle}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="icon" type="image/x-icon" href="/assets/img/logo.png">
</head>
<body class="bg-light">
  <a href="#main-content" class="visually-hidden-focusable position-absolute top-0 start-0 p-2 bg-white border">Saltar al contenido principal</a>
  <div class="min-vh-100 d-flex flex-column">
    <main id="main-content" class="flex-grow-1">
      {{{body}}}
    </main>
    <footer class="py-2 border-top bg-white text-center text-muted small">
      {{appName}}
    </footer>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
