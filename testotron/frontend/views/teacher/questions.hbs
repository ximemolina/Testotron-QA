<div class="container-fluid py-4">
  <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
    <header>
      <h1 class="h3 fw-bold mb-1">
        {{pageTitle}}
      </h1>

      <p class="text-muted mb-0">
        {{pageDescription}}
      </p>
    </header>

    <a
      href="#"
      class="btn text-white"
      style="background-color: var(--color-primary);"
      data-bs-toggle="modal"
      data-bs-target="#questionModal"
      data-context="question-bank"
    >
      <i class="bi bi-plus-lg me-1"></i> Nueva pregunta
    </a>

  </div>

  <section
    class="card border-0 shadow-sm mb-4"
    aria-label="Búsqueda de preguntas"
  >
    <div class="card-body">
      <div class="input-group">
        <span class="input-group-text bg-white border-end-0">
          <i class="bi bi-search" aria-hidden="true"></i>
        </span>
        <input
          type="search"
          id="questionSearch"
          class="form-control border-start-0"
          placeholder="Buscar preguntas por texto, tipo o dificultad..."
          aria-label="Buscar preguntas"
          autocomplete="off"
        >
      </div>
    </div>
  </section>

  <section
    class="row g-4 mb-4"
    aria-label="Estadísticas del banco de preguntas"
  >
    <div class="col-12 col-md-6">
      <article class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="text-muted small mb-2">
            Total de preguntas
          </p>

          <p class="h3 fw-bold mb-0">
            {{stats.totalQuestions}}
          </p>
        </div>
      </article>
    </div>

    <div class="col-12 col-md-6">
      <article class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="text-muted small mb-2">
            En cuestionarios
          </p>

          <p
            class="h3 fw-bold mb-0"
            style="color: var(--color-success);"
          >
            {{stats.mostUsed}}
          </p>
        </div>
      </article>
    </div>
  </section>

  <section
    class="card border-0 shadow-sm"
    aria-labelledby="questions-table-title"
  >
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <caption
            id="questions-table-title"
            class="visually-hidden"
          >
            Listado de preguntas registradas
          </caption>

          <thead class="table-light">
            <tr>
              <th scope="col">
                Pregunta
              </th>

              <th scope="col">
                Tipo
              </th>

              <th scope="col">
                Dificultad
              </th>

              <th scope="col">
                Usos
              </th>

              <th scope="col">
                Acciones
              </th>
            </tr>
          </thead>

          <tbody>
            {{#if questions.length}}
              {{#each questions}}
                {{> question-bank-row}}
              {{/each}}
            {{else}}
              <tr>
                <td
                  colspan="5"
                  class="text-center py-4 text-muted"
                >
                  No hay preguntas registradas.
                </td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {{> question-modal }}

</div>

<script>
const TYPE_LABELS_MAP = {
  multiple_choice: 'Selección única',
  multiple_response: 'Selección múltiple',
  true_false: 'Verdadero / Falso',
  short_answer: 'Respuesta corta',
  fill_blank: 'Completar espacios',
  numeric: 'Numérica',
  essay: 'Ensayo',
  matching: 'Relación de columnas'
};
const DIFF_LABELS_MAP = { easy: 'Fácil', medium: 'Media', hard: 'Difícil' };
const DIFF_VARIANT_MAP = { easy: 'success', Fácil: 'success', medium: 'warning', Media: 'warning', hard: 'danger', Difícil: 'danger' };
function bankTypeLabel(t) { return TYPE_LABELS_MAP[t] || t; }
function bankDiffLabel(d) { return DIFF_LABELS_MAP[d] || d || 'Media'; }
function bankDiffVariant(d) { return DIFF_VARIANT_MAP[d] || DIFF_VARIANT_MAP[DIFF_LABELS_MAP[d]] || 'warning'; }

document.addEventListener(
  'question:saved',
  async function(event) {

    const saveToBank =
      document.getElementById('saveToBank');

    if (!saveToBank?.checked) {
      return;
    }

    const q = event.detail;
    if (!q.question_id) return; // not a bank question

    // If editing, update the existing row
    const existingRow = document.querySelector(`[data-question-id="${q.question_id}"]`);
    if (existingRow) {
      const cells = existingRow.querySelectorAll('td');
      if (cells[0]) cells[0].innerHTML = `<strong>${q.question}</strong>`;
      if (cells[1]) cells[1].textContent = bankTypeLabel(q.type);
      if (cells[2]) cells[2].innerHTML = `<span class="badge text-bg-${bankDiffVariant(q.difficulty)}">${bankDiffLabel(q.difficulty)}</span>`;
      return;
    }

    // Remove empty message row
    const emptyRow = document.querySelector('td[colspan="5"]');
    if (emptyRow) emptyRow.closest('tr').remove();

    // Create new row
    const tbody = document.querySelector('tbody');
    const tr = document.createElement('tr');
    tr.setAttribute('data-question-id', q.question_id);

    tr.innerHTML = `
      <td><strong>${q.question}</strong></td>
      <td>${bankTypeLabel(q.type)}</td>
      <td><span class="badge text-bg-${bankDiffVariant(q.difficulty)}">${bankDiffLabel(q.difficulty)}</span></td>
      <td>0</td>
      <td>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-sm btn-outline-primary" onclick="editQuestion(${q.question_id})" aria-label="Editar pregunta">
            <i class="bi bi-pencil-square"></i>
          </button>
          <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteQuestion(${q.question_id})" aria-label="Eliminar pregunta">
            <i class="bi bi-trash"></i>
          </button>
        </div>
      </td>
    `;

    tbody.prepend(tr);
  }
);

/*
=====================================
REMOVE QUESTION FROM DOM
=====================================
*/

document.addEventListener(
  'question:deleted',
  function(event) {

    const id =
      event.detail.id;

    const row =
      document.querySelector(
        `[data-question-id="${id}"]`
      );

    if (row) {
      row.remove();
    }

  }
);

</script>

<script src="/assets/js/question-modal.js"></script>

<script>
(function() {
  const searchInput = document.getElementById('questionSearch');
  if (!searchInput) return;

  searchInput.addEventListener('input', () => {
    const term = searchInput.value.toLowerCase().trim();
    const rows = document.querySelectorAll('tbody tr[data-question-id], tbody tr:not([colspan])');

    rows.forEach(row => {
      if (!term) { row.hidden = false; return; }
      const text = row.textContent.toLowerCase();
      row.hidden = !text.includes(term);
    });

    // Show empty message if all hidden
    const anyVisible = Array.from(rows).some(r => !r.hidden);
    let emptyRow = document.getElementById('empty-search-row');
    if (!anyVisible && rows.length > 0) {
      if (!emptyRow) {
        emptyRow = document.createElement('tr');
        emptyRow.id = 'empty-search-row';
        emptyRow.innerHTML = '<td colspan="5" class="text-center py-4 text-muted">Sin resultados para la búsqueda.</td>';
        document.querySelector('tbody').appendChild(emptyRow);
      }
    } else if (emptyRow) {
      emptyRow.remove();
    }
  });
})();
</script>
