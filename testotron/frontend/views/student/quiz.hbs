<section class="container py-4" aria-labelledby="quiz-title">

  <header class="mb-4">
    <h1 id="quiz-title" class="h3 fw-bold">{{quizTitle}}</h1>
    <p class="text-muted small">Código: <span class="font-monospace">{{quizCode}}</span></p>
    {{#if quizInstructions}}
      <div class="alert alert-info" role="note">
        <strong>Instrucciones:</strong> {{quizInstructions}}
      </div>
    {{/if}}
  </header>

  <!-- Progress and timer bar -->
  <div class="card border-0 shadow-sm mb-4" id="quiz-meta-bar" style="display:none;">
    <div class="card-body py-2 d-flex justify-content-between align-items-center gap-3">
      <div class="flex-grow-1">
        <div class="d-flex justify-content-between small text-muted mb-1">
          <span>Progreso</span>
          <span id="progress-label">0 de 0 respondidas</span>
        </div>
        <div class="progress" style="height:8px;" role="progressbar"
          aria-label="Progreso del cuestionario" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" id="progress-bar-wrapper">
          <div id="progress-bar" class="progress-bar bg-success" style="width:0%"></div>
        </div>
      </div>
      {{#if timeLimitMinutes}}
        <div class="text-end flex-shrink-0">
          <span class="badge bg-warning text-dark fs-6" id="timer-display" aria-live="polite" aria-label="Tiempo restante">
            <i class="bi bi-clock me-1" aria-hidden="true"></i><span id="timer-text">{{timeLimitMinutes}}:00</span>
          </span>
        </div>
      {{/if}}
    </div>
  </div>

  <div id="quiz-form-container" role="main" aria-live="polite">
    <p class="text-muted">Cargando cuestionario...</p>
  </div>

</section>

<script>
  window.quizTimeLimitMinutes = {{timeLimitMinutes}};
  window.quizCode = '{{quizCode}}';
  window.isGuest = {{#if isGuest}}true{{else}}false{{/if}};
</script>
<script src="/assets/js/student-quiz.js"></script>
