<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <i class="bi bi-clipboard-check text-primary" style="font-size: 2.5rem;"></i>
            <h1 class="h4 fw-bold mt-2">{{quizTitle}}</h1>
            <p class="text-muted small">Ingresa tu nombre para comenzar el cuestionario</p>
          </div>
          <form method="POST" action="/quizzes/join">
            <input type="hidden" name="code" value="{{quizCode}}">
            <div class="mb-4">
              <label for="guestName" class="form-label fw-medium">Tu nombre *</label>
              <input type="text" id="guestName" name="name" class="form-control form-control-lg"
                placeholder="Ej: Juan Pérez" required autofocus maxlength="80">
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg">
              <i class="bi bi-play-fill me-1"></i> Comenzar cuestionario
            </button>
          </form>
          <hr class="my-3">
          <div class="text-center">
            <a href="/auth/login" class="text-muted small">
              <i class="bi bi-box-arrow-in-right me-1"></i> ¿Tienes cuenta? Inicia sesión
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
